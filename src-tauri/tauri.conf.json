{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supasito",
  "version": "0.1.0",
  "identifier": "co.wozu.supasito",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; frame-src http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../starters/next": "starters/next",
      "icons/Assets.car": "Assets.car"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://supasito.com/updates/latest.json?v={{current_version}}&t={{target}}&a={{arch}}",
        "https://github.com/wojtekwoz/supasito/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNkQxMjkxQTYxRkI4ODcKUldTSHVCK21rUkp0djhRS0NqUmFncjU1WkhWT2daRFpaaG5xYlk2bTYxMkUyRDF6VU5WQ01oV24K"
    }
  }
}
